{
  "name": "deadlock-street-brawl-helper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite --mode electron",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -b && vite build --mode electron",
    "dist": "npm run build:electron && electron-builder",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "format": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format && npm run test",
    "fetch-data": "node scripts/fetch-data.mjs --brawl",
    "icon-index": "node scripts/build-icon-index.mjs",
    "brawl": "npx tsx scripts/brawl-cli.ts",
    "brawl:see": "npx tsx scripts/brawl-recognise.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "koffi": "^2.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.7",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.deadlockstreetbrawl.helper",
    "productName": "Deadlock Street Brawl Helper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron-dist/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
